  "lessons": [
    {
      "id": "lesson-hiragana-dakuten",
      "title": "Les sons dakuten et handakuten",
      "description": "Apprenez les sons voisés et semi-voisés du japonais : が, じ, ざ, だ, ば, ぱ",
      "conceptId": "kana-dakuten",
      "conceptType": "kana",
      "order": 3,
      "estimatedDuration": 15,
      "steps": [
        {
          "id": "step-dakuten-intro",
          "type": "presentation",
          "content": {
            "title": "Les sons dakuten (voisés)",
            "body": "Les sons dakuten sont obtenus en ajoutant deux petits traits (゛) sur certains caractères hiragana. Cela rend le son 'voisé'.",
            "japanese": "が じ ざ だ ば",
            "reading": "ga ji za da ba"
          }
        },
        {
          "id": "step-dakuten-ga",
          "type": "explanation",
          "content": {
            "title": "が (ga)",
            "body": "が se prononce 'ga'. C'est le son voisé de か.",
            "japanese": "が",
            "reading": "ga",
            "meaning": "Son voisé de か"
          }
        },
        {
          "id": "step-dakuten-ji",
          "type": "explanation",
          "content": {
            "title": "じ (ji)",
            "body": "じ se prononce 'ji'. C'est le son voisé de し.",
            "japanese": "じ",
            "reading": "ji",
            "meaning": "Son voisé de し"
          }
        },
        {
          "id": "step-dakuten-za",
          "type": "explanation",
          "content": {
            "title": "ざ (za)",
            "body": "ざ se prononce 'za'. C'est le son voisé de さ.",
            "japanese": "ざ",
            "reading": "za",
            "meaning": "Son voisé de さ"
          }
        },
        {
          "id": "step-dakuten-da",
          "type": "explanation",
          "content": {
            "title": "だ (da)",
            "body": "だ se prononce 'da'. C'est le son voisé de た.",
            "japanese": "だ",
            "reading": "da",
            "meaning": "Son voisé de た"
          }
        },
        {
          "id": "step-dakuten-ba",
          "type": "explanation",
          "content": {
            "title": "ば (ba)",
            "body": "ば se prononce 'ba'. C'est le son voisé de は.",
            "japanese": "ば",
            "reading": "ba",
            "meaning": "Son voisé de は"
          }
        },
        {
          "id": "step-dakuten-pa",
          "type": "explanation",
          "content": {
            "title": "ぱ (pa)",
            "body": "ぱ se prononce 'pa'. C'est le son semi-voisé de は (avec un cercle).",
            "japanese": "ぱ",
            "reading": "pa",
            "meaning": "Son semi-voisé de は"
          }
        },
        {
          "id": "step-dakuten-exercise",
          "type": "exercise",
          "content": {
            "title": "Exercice de reconnaissance",
            "body": "Testez vos connaissances sur les sons dakuten !"
          },
          "exerciseId": "ex-hiragana-recog-ga"
        },
        {
          "id": "step-dakuten-check",
          "type": "check",
          "content": {
            "title": "Vérification",
            "body": "Bien joué ! が se prononce 'ga'. Vous maîtrisez le premier son dakuten !"
          }
        },
        {
          "id": "step-dakuten-exercise-2",
          "type": "exercise",
          "content": {
            "title": "Exercice 2",
            "body": "Continuons avec les autres sons dakuten."
          },
          "exerciseId": "ex-hiragana-recog-ji"
        },
        {
          "id": "step-dakuten-synthesis",
          "type": "synthesis",
          "content": {
            "title": "Synthèse",
            "body": "Vous avez appris les sons dakuten : が (ga), じ (ji), ざ (za), だ (da), ば (ba), ぱ (pa). Ces sons sont obtenus en ajoutant des traits aux caractères de base."
          }
        }
      ],
