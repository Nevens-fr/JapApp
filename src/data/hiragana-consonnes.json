      "steps": [
        {
          "id": "step-consonants-intro",
          "type": "presentation",
          "content": {
            "title": "Les consonnes hiragana",
            "body": "Après les voyelles, apprenons les consonnes. Chaque consonne se combine avec les voyelles pour former des syllabes.",
            "japanese": "か き く け こ",
            "reading": "ka ki ku ke ko"
          }
        },
        {
          "id": "step-consonants-ka",
          "type": "explanation",
          "content": {
            "title": "か (ka)",
            "body": "か se prononce 'ka'. C'est la première consonne hiragana.",
            "japanese": "か",
            "reading": "ka",
            "meaning": "Première consonne"
          }
        },
        {
          "id": "step-consonants-ki",
          "type": "explanation",
          "content": {
            "title": "き (ki)",
            "body": "き se prononce 'ki'.",
            "japanese": "き",
            "reading": "ki",
            "meaning": "Deuxième consonne"
          }
        },
        {
          "id": "step-consonants-ku",
          "type": "explanation",
          "content": {
            "title": "く (ku)",
            "body": "く se prononce 'ku'.",
            "japanese": "く",
            "reading": "ku",
            "meaning": "Troisième consonne"
          }
        },
        {
          "id": "step-consonants-ke",
          "type": "explanation",
          "content": {
            "title": "け (ke)",
            "body": "け se prononce 'ke'.",
            "japanese": "け",
            "reading": "ke",
            "meaning": "Quatrième consonne"
          }
        },
        {
          "id": "step-consonants-ko",
          "type": "explanation",
          "content": {
            "title": "こ (ko)",
            "body": "こ se prononce 'ko'.",
            "japanese": "こ",
            "reading": "ko",
            "meaning": "Cinquième consonne"
          }
        },
        {
          "id": "step-consonants-exercise",
