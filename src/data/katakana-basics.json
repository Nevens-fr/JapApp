        {
          "id": "step-katakana-vowels-intro",
          "type": "presentation",
          "content": {
            "title": "Les voyelles katakana",
            "body": "Les katakana représentent les mêmes sons que les hiragana, mais avec des formes différentes. Ils sont utilisés pour les mots étrangers et les onomatopées.",
            "japanese": "ア イ ウ エ オ",
            "reading": "a i u e o"
          }
        },
        {
          "id": "step-katakana-vowels-a",
          "type": "explanation",
          "content": {
            "title": "ア (a)",
            "body": "ア se prononce 'a'. C'est la première voyelle katakana.",
            "japanese": "ア",
            "reading": "a",
            "meaning": "Première voyelle"
          }
        },
        {
          "id": "step-katakana-vowels-i",
          "type": "explanation",
          "content": {
            "title": "イ (i)",
            "body": "イ se prononce 'i'.",
            "japanese": "イ",
            "reading": "i",
            "meaning": "Deuxième voyelle"
          }
        },
        {
          "id": "step-katakana-vowels-u",
          "type": "explanation",
          "content": {
            "title": "ウ (u)",
            "body": "ウ se prononce 'u'.",
            "japanese": "ウ",
            "reading": "u",
            "meaning": "Troisième voyelle"
          }
        },
        {
          "id": "step-katakana-vowels-e",
          "type": "explanation",
          "content": {
            "title": "エ (e)",
            "body": "エ se prononce 'e'.",
            "japanese": "エ",
            "reading": "e",
            "meaning": "Quatrième voyelle"
          }
        },
        {
          "id": "step-katakana-vowels-o",
          "type": "explanation",
          "content": {
            "title": "オ (o)",
            "body": "オ se prononce 'o'.",
            "japanese": "オ",
            "reading": "o",
            "meaning": "Cinquième voyelle"
          }
        },
