  "lessons": [
    {
      "id": "lesson-hiragana-yoon",
      "title": "Les yōon et les sons spéciaux",
      "description": "Apprenez les yōon (sons combinés avec y) et les sons spéciaux : ゃ, ゅ, ょ, わ, を, ん",
      "conceptId": "kana-yoon",
      "conceptType": "kana",
      "order": 4,
      "estimatedDuration": 15,
      "steps": [
        {
          "id": "step-yoon-intro",
          "type": "presentation",
          "content": {
            "title": "Les yōon (sons combinés)",
            "body": "Les yōon sont formés en combinant les consonnes avec les semi-voyelles y. Ils utilisent des petits caractères ゃ, ゅ, ょ.",
            "japanese": "きゃ きゅ きょ",
            "reading": "kya kyu kyo"
          }
        },
        {
          "id": "step-yoon-ya",
          "type": "explanation",
          "content": {
            "title": "ゃ (ya)",
            "body": "ゃ se prononce 'ya'. C'est un petit ya utilisé pour former des yōon.",
            "japanese": "ゃ",
            "reading": "ya",
            "meaning": "Petit ya"
          }
        },
        {
          "id": "step-yoon-yu",
          "type": "explanation",
          "content": {
            "title": "ゅ (yu)",
            "body": "ゅ se prononce 'yu'. C'est un petit yu utilisé pour former des yōon.",
            "japanese": "ゅ",
            "reading": "yu",
            "meaning": "Petit yu"
          }
        },
        {
          "id": "step-yoon-yo",
          "type": "explanation",
          "content": {
            "title": "ょ (yo)",
            "body": "ょ se prononce 'yo'. C'est un petit yo utilisé pour former des yōon.",
            "japanese": "ょ",
            "reading": "yo",
            "meaning": "Petit yo"
          }
        },
        {
          "id": "step-yoon-wa",
          "type": "explanation",
          "content": {
            "title": "わ (wa)",
            "body": "わ se prononce 'wa'. C'est un son de voyelle.",
            "japanese": "わ",
            "reading": "wa",
            "meaning": "Voyelle wa"
          }
        },
        {
          "id": "step-yoon-wo",
          "type": "explanation",
          "content": {
            "title": "を (wo)",
            "body": "を se prononce 'wo' (ou 'o' en practice). C'est utilisé comme particule objet.",
            "japanese": "を",
            "reading": "wo",
            "meaning": "Particule objet"
          }
        },
        {
          "id": "step-yoon-n",
          "type": "explanation",
          "content": {
            "title": "ん (n)",
            "body": "ん se prononce 'n'. C'est le seul son nasal des hiragana.",
            "japanese": "ん",
            "reading": "n",
            "meaning": "Son nasal"
          }
        },
        {
          "id": "step-yoon-exercise",
          "type": "exercise",
          "content": {
            "title": "Exercice de reconnaissance",
            "body": "Testez vos connaissances sur les yōon et les sons spéciaux !"
          },
          "exerciseId": "ex-hiragana-recog-ya"
        },
        {
          "id": "step-yoon-check",
          "type": "check",
          "content": {
            "title": "Vérification",
            "body": "Bien joué ! ゃ se prononce 'ya'. Vous maîtrisez le premier yōon !"
          }
        },
        {
          "id": "step-yoon-exercise-2",
          "type": "exercise",
          "content": {
            "title": "Exercice 2",
            "body": "Continuons avec les autres yōon."
          },
          "exerciseId": "ex-hiragana-recog-yu"
        },
        {
          "id": "step-yoon-synthesis",
          "type": "synthesis",
          "content": {
            "title": "Synthèse",
            "body": "Vous avez appris les yōon et les sons spéciaux : ゃ (ya), ゅ (yu), ょ (yo), わ (wa), を (wo), ん (n). Ces sons complètent le syllabaire hiragana."
          }
        }
      ],
