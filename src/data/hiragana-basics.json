  "lessons": [
    {
      "id": "lesson-hiragana-vowels",
      "title": "Les 5 voyelles hiragana",
      "description": "Apprenez les 5 voyelles fondamentales du japonais : あ, い, う, え, お",
      "conceptId": "kana-vowels",
      "conceptType": "kana",
      "order": 1,
      "estimatedDuration": 10,
      "steps": [
        {
          "id": "step-vowels-intro",
          "type": "presentation",
          "content": {
            "title": "Les voyelles hiragana",
            "body": "Le japonais possède 5 voyelles de base qui sont fondamentales pour tout apprentissage. Chaque voyelle a un caractère hiragana unique.",
            "japanese": "あ い う え お",
            "reading": "a i u e o"
          }
        },
        {
          "id": "step-vowels-a",
          "type": "explanation",
          "content": {
            "title": "あ (a)",
            "body": "Le premier caractère hiragana se prononce 'a'. C'est la voyelle la plus simple.",
            "japanese": "あ",
            "reading": "a",
            "meaning": "Première voyelle"
          }
        },
        {
          "id": "step-vowels-i",
          "type": "explanation",
          "content": {
            "title": "い (i)",
            "body": "い se prononce 'i'. Sa forme ressemble à deux piliers verticaux.",
            "japanese": "い",
            "reading": "i",
            "meaning": "Deuxième voyelle"
          }
        },
        {
          "id": "step-vowels-u",
          "type": "explanation",
          "content": {
            "title": "う (u)",
            "body": "う se prononce 'u'. Sa forme est fluide et courbe.",
            "japanese": "う",
            "reading": "u",
            "meaning": "Troisième voyelle"
          }
        },
        {
          "id": "step-vowels-e",
          "type": "explanation",
          "content": {
            "title": "え (e)",
            "body": "え se prononce 'e'. Sa forme ressemble à un caractère stylisé.",
            "japanese": "え",
            "reading": "e",
            "meaning": "Quatrième voyelle"
          }
        },
        {
          "id": "step-vowels-o",
          "type": "explanation",
          "content": {
            "title": "お (o)",
            "body": "お se prononce 'o'. Sa forme est unique avec une boucle.",
            "japanese": "お",
            "reading": "o",
            "meaning": "Cinquième voyelle"
          }
        },
        {
          "id": "step-vowels-exercise",
          "type": "exercise",
          "content": {
            "title": "Exercice de reconnaissance",
            "body": "Testez vos connaissances sur les voyelles hiragana !"
